server {
  listen 443 ssl;
  server_name _;
  ssl_certificate /etc/erp-tls/server.crt;
  ssl_certificate_key /etc/erp-tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $erp_gateway http://gateway:8000;
  set $erp_web http://web:${WEB_INTERNAL_PORT};
  # The gateway and API enforce upload limits. Do not buffer before the gateway.
  client_max_body_size 0;
  client_body_timeout 30s;
  proxy_connect_timeout 5s;
  proxy_read_timeout 120s;
  proxy_send_timeout 30s;
  proxy_request_buffering off;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  location /api/ { proxy_pass $erp_gateway; }
  location = /health { proxy_pass $erp_gateway; }
  location / {
    proxy_pass $erp_web;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
